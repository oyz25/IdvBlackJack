{
    "interface_version": 2,
    "name": "IDVBlackjack",
    "label": "IDV Blackjack Automation",
    "description": "Automatically runs the Blackjack task repeatedly.",
    "license": "MIT",
    "version": "1.0.0",
    "controller": [
        {
            "name": "桌面端",
            "label": "Desktop",
            "type": "Win32",
            "display_short_side": 720,
            "win32": {
                // Temporarily show all windows.
                // Select the game window in the Maa control panel.
                "class_regex": ".*",
                "window_regex": ".*",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessage"
            }
        }
    ],
    "resource": [
        {
            "name": "默认资源",
            "label": "Default Resource",
            "path": [
                "./resource"
            ],
            "controller": [
                "桌面端"
            ]
        }
    ],
    "task": [
        {
            "name": "Blackjack循环",
            "label": "Run Blackjack Loop",
            "description": "Runs the complete Blackjack process repeatedly.",
            "entry": "clickbook",
            "default_check": true,
            "controller": [
                "桌面端"
            ],
            "resource": [
                "默认资源"
            ]
        }
    ]
}